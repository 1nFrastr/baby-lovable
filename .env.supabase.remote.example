# Linked / hosted Supabase — copy to .env.supabase.remote or run:
#   npm run supabase:use -- save-remote
# (first `npm run supabase:use-local` also snapshots remote from .env.local)

BABY_LOVABLE_SUPABASE_TARGET=remote
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
BABY_LOVABLE_DEV_USER_ID=
