# Copy to `.env.local` (gitignored). Local Host only — local Supabase.
# Production / hosted secrets: Vercel Dashboard (not kept in this repo).

# Required for AI chat
AI_GATEWAY_API_KEY=
AI_MODEL=zai/glm-5.3-flash
# GLM 5.3 Flash is native multimodal. Optional override when AI_MODEL cannot
# see images (e.g. deepseek/deepseek-v4-flash → deepseek/deepseek-v4-flash-vision-exp).
# AI_VISION_MODEL=
# Optional. Builder default is low (DeepSeek provider-default is high).
# AI_REASONING=low
# Optional context compaction. Defaults: 100000 tokens, keep 8 recent messages.
# Lower both locally (e.g. 8000 / 2) to trigger sealed-layer compaction sooner.
# AI_CONTEXT_COMPACT_TOKENS=100000
# AI_CONTEXT_KEEP_RECENT=8

# CLI / trusted server context (no browser cookie).
# Local stack seed (supabase/seed.sql):
BABY_LOVABLE_DEV_USER_ID=11111111-1111-1111-1111-111111111111

# Local Supabase (`supabase start`). Studio: http://127.0.0.1:54323
# Copy ANON_KEY / SERVICE_ROLE_KEY from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Daytona (sandbox) — used when SANDBOX_PROVIDER=daytona or for sticky old sessions
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
DAYTONA_DEV_PORT=3000
DAYTONA_SNAPSHOT=baby-lovable-nextjs-starter-2g-warm2

# Default sandbox provider for new sessions: vercel | daytona
SANDBOX_PROVIDER=vercel
# Shared preview port / idle stop window (both providers)
# SANDBOX_DEV_PORT=3000
# Vercel idle default is 15 minutes; Daytona stays 30 unless set here.
# SANDBOX_IDLE_MINUTES=15
# Vercel: 1 vCPU / 2 GiB RAM (disk is not configurable). Ephemeral; idle-stops
# after SANDBOX_IDLE_MINUTES of no agent/preview activity (activity resets the window).
# VERCEL_SANDBOX_VCPUS=1

# Vercel Sandbox (default provider)
# Local: VERCEL_TOKEN + VERCEL_TEAM_ID + VERCEL_PROJECT_ID
# Production on Vercel: OIDC is used automatically.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# Team URL slug for the VCR image path. Required when VERCEL_TOKEN cannot call
# GET /v2/teams (some permanent project tokens). Example: freddyx
# VERCEL_TEAM_SLUG=
# Vercel Sandbox custom image (required). Bake + push to VCR:
#   npm run build:vercel-image
# Default name: baby-lovable-nextjs-starter (starter + pnpm + node_modules + .next/dev).
# VERCEL_SANDBOX_IMAGE=baby-lovable-nextjs-starter
# Optional extra freeze of a running sandbox (on top of the image):
# VERCEL_SANDBOX_SNAPSHOT=

# Freestyle Git (durable source of truth for sandbox workspaces).
# Required for Vercel sessions. For Daytona, required unless DAYTONA_FREE_PLAN=1.
FREESTYLE_API_KEY=
# Daytona-only free-tier stand-in: skip Freestyle provision, turn checkpoints,
# GitHub Sync, History, and Export for Daytona sessions. Vercel ignores this flag
# (custom network allowlist already includes Freestyle / npm / GitHub).
# Also omits Daytona sandbox domainAllowList (required on Daytona Tier 1–2).
# DAYTONA_FREE_PLAN=1

# Keenable CLI (builder web search / page fetch). Optional.
# Without a key the public pool applies (lower rate limits). Never commit a real key.
# KEENABLE_API_KEY=

# GitHub App (one-click create repo + Freestyle GitHub Sync)
# Setup URL on App settings: http://localhost:3000/api/github/app/setup
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_INSTALL_URL=https://github.com/apps/<your-app>/installations/new
