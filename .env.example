# Vercel AI Gateway (recommended) — https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# AI Gateway model id, e.g. minimax/minimax-m3
AI_MODEL=minimax/minimax-m3

# Per-step max output tokens ceiling (default 32000; clamped to provider limit)
# AI_MAX_OUTPUT_TOKENS=32000

# Invisible auto-continue rounds when a step hits output token limit (default 2)
# AI_AUTO_CONTINUE_MAX=2

# Or use a provider directly, e.g. OpenAI:
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Supabase (via Vercel Marketplace — auto-synced, do not set manually on Vercel)
# @see https://supabase.com/docs/guides/integrations/vercel-marketplace
# For local dev, copy values from Vercel project Settings → Environment Variables.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# Legacy naming (older integrations) — also supported:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Local file-mode data root (used when Supabase env vars are absent).
# Absolute or cwd-relative. On Vercel/Lambda defaults to /tmp/baby-lovable
# (deploy dir is read-only); locally defaults to .baby-lovable.
# BABY_LOVABLE_DATA_DIR=.baby-lovable

# Default sandbox for new sessions (web UI + CLI without --sandbox).
# local (default) | daytona — not selectable in the web UI.
# BABY_LOVABLE_SANDBOX_MODE=local

# ---------------------------------------------------------------------------
# Daytona (remote sandbox + volume persistence)
# ---------------------------------------------------------------------------
# DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us
# DAYTONA_VOLUME_NAME=baby-lovable-workspaces
# DAYTONA_SANDBOX_IDLE_MINUTES=30
# DAYTONA_DEV_PORT=3000
# Prebuilt snapshot (starter + pnpm + node_modules). Build / rebuild:
#   npm run build:daytona-snapshot -- --force
# Set to empty string to disable and fall back to runtime seed + install.
# DAYTONA_SNAPSHOT=baby-lovable-nextjs-starter-2g
# If snapshot create fails, default is fail-hard. Set to 1 to boot a default
# image instead (slow path: runtime seed + pnpm install).
# DAYTONA_SNAPSHOT_FALLBACK=0
# Local workspace + volume mount paths inside the sandbox (defaults shown)
# DAYTONA_WORKSPACE_ROOT=/home/daytona/workspace
# DAYTONA_VOLUME_MOUNT=/home/daytona/persist

# ---------------------------------------------------------------------------
# Freestyle Git (required for Daytona sandboxMode)
FREESTYLE_API_KEY=
# Soft-delete retention before Freestyle repo GC (days, default 30)
# FREESTYLE_REPO_RETENTION_DAYS=30
# Optional Daytona outbound domain allow-list (Freestyle is not in Essential Services)
# DAYTONA_DOMAIN_ALLOW_LIST=git.freestyle.sh,api.freestyle.sh,*.freestyle.sh,github.com,*.github.com,registry.npmjs.org
# ---------------------------------------------------------------------------
# GitHub App (select an empty personal repo + Freestyle GitHub Sync)
# Same App must be bound in Freestyle Dashboard → Git > Sync.
# Disable "Request user authorization (OAuth) during installation".
# Setup URL: https://<your-host>/api/github/app/setup
# Enable "Redirect on update" so repository permission changes return to the app.
# GitHub permits only one Setup URL; use a separate App or tunnel for local testing.
# Permissions: Contents R/W and Metadata. Repository creation is not requested.
# ---------------------------------------------------------------------------
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_INSTALL_URL=https://github.com/apps/<your-app>/installations/new
# GITHUB_APP_SLUG=<your-app>   # optional if install URL contains /apps/<slug>/

# ---------------------------------------------------------------------------
# Cloudflare Browser Run (App Testing against Daytona preview)
# https://developers.cloudflare.com/browser-run/
# Token needs "Browser Rendering - Edit". Local sandbox cannot be tested.
# ---------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_BROWSER_RUN_API_TOKEN=
# Aliases also accepted: CF_ACCOUNT_ID, CF_API_TOKEN
# Disk screenshots/report (default: on locally, off on Vercel)
# BABY_LOVABLE_APP_TEST_ARTIFACTS=0

# App-test / PiP status always uses durable store (local file or Supabase) —
# same path as Vercel. No in-memory fast path.
# Optional: artificial write lag for stress tests (ms).
# BABY_LOVABLE_APP_TEST_STATUS_WRITE_DELAY_MS=800
# Deprecated no-op (status is always durable-only):
# BABY_LOVABLE_SIMULATE_SERVERLESS=1

# Force local file storage + skip login (CLI / automated tests). Use when
# `.env.local` has Supabase vars from `vercel env pull` but you want no Postgres.
# BABY_LOVABLE_LOCAL_MODE=1
# NEXT_PUBLIC_BABY_LOVABLE_LOCAL_MODE=1   # required for web UI (client bundle)

# CLI / headless dev user (Supabase `auth.users.id`) when no browser session
# BABY_LOVABLE_DEV_USER_ID=
