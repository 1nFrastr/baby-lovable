# Copy to `.env.local` (gitignored). Local Host only — local Supabase.
# Production / hosted secrets: Vercel Dashboard (not kept in this repo).

# Required for AI chat
AI_GATEWAY_API_KEY=
AI_MODEL=deepseek/deepseek-v4-flash
# Optional. Builder default is low (DeepSeek provider-default is high).
# AI_REASONING=low
# Optional context compaction. Defaults: 100000 tokens, keep 8 recent messages.
# Lower both locally (e.g. 8000 / 2) to trigger sealed-layer compaction sooner.
# AI_CONTEXT_COMPACT_TOKENS=100000
# AI_CONTEXT_KEEP_RECENT=8

# CLI / trusted server context (no browser cookie).
# Local stack seed (supabase/seed.sql):
BABY_LOVABLE_DEV_USER_ID=11111111-1111-1111-1111-111111111111

# Local Supabase (`supabase start`). Studio: http://127.0.0.1:54323
# Copy ANON_KEY / SERVICE_ROLE_KEY from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Daytona (sandbox)
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
DAYTONA_DEV_PORT=3000
DAYTONA_SNAPSHOT=baby-lovable-nextjs-starter-2g-warm2

# Freestyle Git (required for Daytona workspaces)
FREESTYLE_API_KEY=

# Cloudflare Browser Run
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BROWSER_RUN_API_TOKEN=

# GitHub App (one-click create repo + Freestyle GitHub Sync)
# Setup URL on App settings: http://localhost:3000/api/github/app/setup
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_INSTALL_URL=https://github.com/apps/<your-app>/installations/new
